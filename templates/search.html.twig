{% extends 'partials/base.html.twig' %}

{% block content %}
{% set query = uri.query('q') %}
{% set search_type = uri.query('type')|default('projects') %}

<article class="project-post">
    <header class="project-header">
        <h1>{{ 'THEME_SWISS.SEARCH_ARCHIVE'|t }}</h1>
    </header>

    <form method="GET" action="{{ page.url }}" class="search-form">
        <input type="text" name="q" value="{{ query }}" placeholder="{{ 'THEME_SWISS.SEARCH_TERM'|t }}" required class="search-input">
        
        <select name="type" class="search-input">
            <option value="projects" {% if search_type == 'projects' %}selected{% endif %}>{{ 'THEME_SWISS.PROJECTS'|t }}</option>
            <option value="microblog" {% if search_type == 'microblog' %}selected{% endif %}>{{ 'THEME_SWISS.MICROBLOG'|t }}</option>
        </select>
        
        <button type="submit" class="search-button">{{ 'THEME_SWISS.SEARCH'|t }}</button>
    </form>

    {% if query %}
        <h2 class="section-title" style="margin-top: 3rem;">{{ 'THEME_SWISS.RESULTS_FOR'|t(query) }}</h2>
        
        {# Select the right collection based on the dropdown #}
        {% if search_type == 'microblog' %}
            {% set collection = page.find('/microblog').children %}
        {% else %}
            {% set active_categories = taxonomy.getTaxonomyItemKeys('category') %}
            {% set query_items = [] %}
            {% for cat in active_categories %}
                {% set query_items = query_items|merge([{'@taxonomy': {'category': cat}}]) %}
            {% endfor %}

            {% set collection = page.collection({'items': query_items}) %}
        {% endif %}

        {% set results_found = false %}
        
        <div class="search-results" style="margin-top: 2rem;">
            {# Loop through all posts and check if the query is in the title or content #}
            {% for p in collection if query|lower in p.title|lower or query|lower in p.content|lower %}
                {% set results_found = true %}
                
                <article class="preview-block">
                    {% if search_type == 'microblog' %}
                        <div class="micro-date">{{ p.date|date("Y-m-d, H:i") }}</div>
                        <div class="micro-content">{{ p.content|raw }}</div>
                    {% else %}
                        <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
                        <div class="project-meta">
                            <span class="meta-item">{{ 'THEME_SWISS.PUBLISHED'|t }}: <strong>{{ p.date|date("Y-m-d") }}</strong></span>
                        </div>
                        {{ p.summary(150)|raw }}
                    {% endif %}
                </article>
            {% endfor %}
            
            {% if not results_found %}
                <p><em>{{ 'THEME_SWISS.NO_MATCHES'|t(search_type) }}</em></p>
            {% endif %}
        </div>
    {% endif %}
</article>
{% endblock %}