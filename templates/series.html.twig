{% extends 'partials/base.html.twig' %}

{% block content %}
<article class="project-post">
    <header class="project-header">
        <h1>{{ 'THEME_SWISS.SERIES_HEADER'|t }}</h1>
        <p>{{ 'THEME_SWISS.SERIES_HEADER_TEXT'|t }}</p>
    </header>

    {# Fetch all projects and order them oldest to newest so they read like a book #}
    {% set active_categories = taxonomy.getTaxonomyItemKeys('category') %}
    {% set query_items = [] %}
    {% for cat in active_categories %}
        {% set query_items = query_items|merge([{'@taxonomy': {'category': cat}}]) %}
    {% endfor %}

    {% set all_projects = page.collection({'items': query_items}) %}
    
    {# Extract unique series names #}
    {% set series_list = [] %}
    {% for p in all_projects %}
        {% if p.header.taxonomy.series %}
            {% set s_name = p.header.taxonomy.series %}
            {% if s_name not in series_list %}
                {% set series_list = series_list|merge([s_name]) %}
            {% endif %}
        {% endif %}
    {% endfor %}

    <div class="series-index" style="margin-top: 3rem;">
        {% if series_list|length > 0 %}
            {% for s in series_list %}
                <h2 class="section-title">{{ s }}</h2>
                <ul class="series-list">
                {% for p in all_projects if p.header.taxonomy.series == s %}
                    <li>
                        <span class="micro-date" style="border:none; margin-right: 1rem;">{{ p.date|date("d.m.Y") }}</span>
                        <a href="{{ p.url }}"><strong>{{ p.title }}</strong></a>
                    </li>
                {% endfor %}
                </ul>
            {% endfor %}
        {% else %}
            <p><em>{{ 'THEME_SWISS.NO_SERIES'|t }}</em></p>
        {% endif %}
    </div>
</article>
{% endblock %}