{% extends 'partials/base.html.twig' %}

{% block content %}
<div class="dashboard">
    <section class="main-column">
        
        {# SHOWCASE: Pulls any project where featured is toggled on #}
        <h2 class="section-title">Showcase</h2>
        {% set showcase = taxonomy.findTaxonomy({'category': ['analog', 'digital']}) %}
        {% for p in showcase if p.header.featured %}
            <article class="preview-block featured-block">
                <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
                <p><em>{{ p.header.taxonomy.category|first|capitalize }} &mdash; {{ p.header.time_spent }}</em></p>
                {{ p.summary(200)|raw }}
            </article>
        {% endfor %}

        {# LATEST: Pulls the 5 newest projects overall #}
        <h2 class="section-title">Latest Projects</h2>
        {% set projects = taxonomy.findTaxonomy({'category': ['analog', 'digital']}).order('date', 'desc').slice(0, 5) %}
        {% for p in projects %}
            <article class="preview-block">
                <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
                {{ p.summary(150)|raw }}
            </article>
        {% endfor %}
        
    </section>

    <aside class="microblog-column">
        <h2 class="section-title">Microblog</h2>
        {# Pulls all child pages from the hidden /microblog folder #}
        {% set micro_posts = page.find('/microblog').children.order('date', 'desc').slice(0, 10) %}
        
        {% for m in micro_posts %}
            <div class="micro-post">
                <div class="micro-date">{{ m.date|date("M d, Y") }}</div>
                <div class="micro-content">
                    {{ m.content|raw }}
                </div>
            </div>
        {% endfor %}
        
        <a href="{{ base_url }}/microblog" class="view-all">View Archive &rarr;</a>
    </aside>
</div>
{% endblock %}