{% extends 'partials/base.html.twig' %}

{% block content %}
<div class="dashboard">
    <section class="main-column">
        
        {% set active_categories = taxonomy.getTaxonomyItemKeys('category') %}
        {% set query_items = [] %}
        {% for cat in active_categories %}
            {% set query_items = query_items|merge([{'@taxonomy': {'category': cat}}]) %}
        {% endfor %}

        {% set all_projects = page.collection({'items': query_items}) %}

        {# SHOWCASE #}
        <h2 class="section-title">{{ 'THEME_SWISS.SHOWCASE'|t }}</h2>
        {% set has_showcase = false %}
        
        {% for p in all_projects if p.header.featured %}
            {% set has_showcase = true %}
            <article class="preview-block featured-block">
                <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
                <p>
                    <em>
                        {{ (p.header.taxonomy.category is iterable ? p.header.taxonomy.category|first : p.header.taxonomy.category)|capitalize|default('Project') }}
                        {% if p.header.time_spent %}
                            &mdash; {{ 'THEME_SWISS.TIME_SPENT'|t }}: {{ p.header.time_spent }}
                        {% endif %}
                    </em>
                </p>
                {{ p.summary(200)|raw }}
            </article>
        {% endfor %}

        {% if not has_showcase %}
            <p style="margin-bottom: 2rem;"><em>{{ 'THEME_SWISS.NO_SHOWCASE'|t }}</em></p>
        {% endif %}

        {# LATEST #}
        <h2 class="section-title">{{ 'THEME_SWISS.LATEST'|t }}</h2>
        {% set latest_projects = all_projects.order('date', 'desc').slice(0, 5) %}
        
        {% for p in latest_projects %}
            <article class="preview-block">
                <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
                {{ p.summary(150)|raw }}
            </article>
        {% else %}
            <p><em>{{ 'THEME_SWISS.NO_PROJECTS'|t }}</em></p>
        {% endfor %}
        
    </section>

    <aside class="microblog-column">
        <h2 class="section-title">{{ 'THEME_SWISS.MICROBLOG'|t }}</h2>
        {% set microblog_page = page.find('/microblog') %}
        
        {% if microblog_page %}
            {% set micro_posts = microblog_page.children.order('date', 'desc').slice(0, 10) %}
            {% for m in micro_posts %}
                <div class="micro-post">
                    <div class="micro-date">{{ m.date|date("Y-m-d, H:i") }}</div>
                    <div class="micro-content">
                        {{ m.content|raw }}
                    </div>
                </div>
            {% else %}
                <p><em>{{ 'THEME_SWISS.NO_MICROBLOG'|t }}</em></p>
            {% endfor %}
        {% else %}
            <p><em>{{ 'THEME_SWISS.MICROBLOG_MISSING'|t }}</em></p>
        {% endif %}
        
        <a href="{{ base_url }}/microblog" class="view-all">{{ 'THEME_SWISS.VIEW_ARCHIVE'|t }}</a>
    </aside>
</div>
{% endblock %}