<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: 'en' }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title }} | {{ site.title }}</title>
    <link rel="stylesheet" href="{{ url('theme://css/style.css') }}">
    
    {# This overrides the accent color from style.css with the admin panel choice #}
    <style>
        :root {
            --accent-color: {{ theme_var('accent_color', '#a84b32') }};
        }
    </style>
</head>
<body class="site-layout">
    <header class="site-header">
        <a href="{{ base_url == '' ? '/' : base_url }}" class="site-title">{{ site.title|default('My Portfolio') }}</a>
        <nav class="site-nav">
            {# Automatically creates links for any category you use (Analog, Digital, Photography, etc.) #}
            {% for cat in taxonomy.getTaxonomyItemKeys('category') %}
                <a href="{{ base_url }}/{{ cat }}">{{ cat|capitalize }}</a>
            {% endfor %}
            <a href="{{ base_url }}/series">{{ 'THEME_SWISS.SERIES'|t }}</a>
            <a href="{{ base_url }}/search">{{ 'THEME_SWISS.SEARCH'|t }}</a>
        </nav>
    </header>

    <main class="site-main">
        {% block content %}{% endblock %}
    </main>

    <hr class="footer-rule">

    <footer class="site-footer">
        <p>&copy; {{ "now"|date("Y") }} {{ site.title }} | {{ theme_var('custom_footer', 'Minimal CSS, Zero JS.') }}</p>
    </footer>
</body>
</html>