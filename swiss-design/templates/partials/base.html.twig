<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title }} | {{ site.title }}</title>
    <link rel="stylesheet" href="{{ url('theme://css/style.css') }}">
    
    {# This overrides the accent color from style.css with the admin panel choice #}
    <style>
        :root {
            --accent-color: {{ theme_var('accent_color', '#a84b32') }};
        }
    </style>
</head>
<body>
    <header class="site-header">
        <a href="{{ base_url == '' ? '/' : base_url }}" class="site-title">{{ site.title|default('My Portfolio') }}</a>
        <nav>
            <a href="{{ base_url }}/analog">Analog</a>
            <a href="{{ base_url }}/digital">Digital</a>
            <a href="{{ base_url }}/series">Series</a>
            <a href="{{ base_url }}/search">Search</a>
        </nav>
    </header>

    <main>
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        {# This injects the custom footer text #}
        <p>&copy; {{ "now"|date("Y") }} | {{ theme_var('custom_footer', 'Minimal CSS, Zero JS.') }}</p>
    </footer>
</body>
</html>